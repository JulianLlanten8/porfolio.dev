---
interface Props {
  href: string
  'aria-label'?: string
  download?: boolean | string
  class?: string
}

const { 'aria-label': ariaLabel, class: className = '', ...rest } = Astro.props
---

<a
  {...rest}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  role="link"
  class={`inline-flex items-center justify-center gap-2 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-lg hover:border-slate-400 dark:hover:border-slate-600 hover:text-slate-950 dark:hover:text-white transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 active:scale-[0.98] ${className}`}
>
  <slot />
</a>