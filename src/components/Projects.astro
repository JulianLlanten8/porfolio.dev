---
import { PROJECTS } from '@/data/projects'
import { TAGS } from '@/config/tags'
import GitHub from './icons/GitHub.astro'
import VueJS from './icons/VueJs.astro'
import Javascript from './icons/Javascript.astro'
import TypeScript from './icons/TypeScript.astro'
import React from './icons/React.astro'
import CSS from './icons/CSS.astro'
import Link from './icons/Link.astro'
import LinkButton from './LinkButton.astro'
import Tailwind from './icons/Tailwind.astro'
import NextJS from './icons/NextJS.astro'
import Laravel from './icons/Laravel.astro'

const TAG_ICONS = {
  VUE: VueJS,
  TAILWIND: Tailwind,
  CSS: CSS,
  JAVASCRIPT: Javascript,
  TYPESCRIPT: TypeScript,
  REACT: React,
  NEXTJS: NextJS,
  LARAVEL: Laravel,
}
---

<div class="flex flex-col gap-16 md:gap-20">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }, index) => {
      const projectNumber = String(index + 1).padStart(2, '0')
      return (
        <article class="group grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center p-4 sm:p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/60 dark:bg-[#0c1220]/60 backdrop-blur-xs transition-all duration-300 hover:border-slate-300 dark:hover:border-slate-700 hover:shadow-lg hover:shadow-slate-950/5 dark:hover:shadow-black/20">
          <!-- Columna Visual (6 cols) -->
          <div class="md:col-span-6 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800/80 bg-slate-100 dark:bg-slate-900">
            <div class="flex items-center gap-1.5 px-3 py-2 border-b border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-900/90 text-xs font-mono-tech text-slate-500">
              <span class="size-2 rounded-full bg-slate-300 dark:bg-slate-700"></span>
              <span class="size-2 rounded-full bg-slate-300 dark:bg-slate-700"></span>
              <span class="size-2 rounded-full bg-slate-300 dark:bg-slate-700"></span>
              <span class="ml-2 text-[11px] truncate text-slate-500 dark:text-slate-400">
                {link ? new URL(link).hostname : title}
              </span>
            </div>
            <a
              href={link ?? github}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
              class="block aspect-video overflow-hidden"
            >
              <img
                alt={title}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                src={image}
                width="640"
                height="360"
              />
            </a>
          </div>

          <!-- Columna de Información (6 cols) -->
          <div class="md:col-span-6 flex flex-col justify-between h-full py-1">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-mono-tech text-xs text-sky-600 dark:text-sky-400 font-semibold tracking-wider">
                  SYS-{projectNumber}
                </span>
                {link && (
                  <span class="inline-flex items-center gap-1 text-[11px] font-mono-tech text-emerald-600 dark:text-emerald-400">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Online
                  </span>
                )}
              </div>

              <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                {title}
              </h3>

              <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300 text-pretty">
                {description}
              </p>
            </div>

            <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex flex-col gap-4">
              <!-- Stack Tecnológico -->
              <ul class="flex flex-wrap gap-1.5">
                {tags.map((tagKey) => {
                  const tag = TAGS[tagKey]
                  const Icon = TAG_ICONS[tagKey]
                  return (
                    <li>
                      <span class={`inline-flex items-center gap-1.5 rounded-md text-xs font-medium py-1 px-2.5 ${tag.class}`}>
                        <Icon class="size-3.5" />
                        {tag.name}
                      </span>
                    </li>
                  )
                })}
              </ul>

              <!-- Acciones -->
              <div class="flex items-center gap-2 pt-1">
                {link && (
                  <LinkButton href={link} variant="primary">
                    <Link class="size-3.5" />
                    Ver proyecto en vivo
                  </LinkButton>
                )}
                {github && (
                  <LinkButton href={github} variant="secondary">
                    <GitHub class="size-3.5" />
                    Repositorio
                  </LinkButton>
                )}
              </div>
            </div>
          </div>
        </article>
      )
    })
  }
</div>