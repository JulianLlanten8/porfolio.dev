---
import { PERSONAL } from '@/config/personal'
---

<article class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
  <!-- Columna de Texto Editorial (7 cols) -->
  <div class="md:col-span-7 flex flex-col gap-5 text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed text-pretty">
    <p>
      Mi formación y trayectoria combinan dos mundos que rara vez conversan con fluidez: el <strong class="font-semibold text-slate-900 dark:text-white">análisis de requerimientos de información</strong> y la <strong class="font-semibold text-slate-900 dark:text-white">ingeniería de software full stack</strong>. Antes de escribir una sola línea de código, modelo los datos, identifico cuellos de botella y entiendo la operación real del negocio.
    </p>

    <p>
      Durante los últimos años he diseñado e implementado plataformas críticas: desde sistemas de gestión y acreditación de eventos para <span class="text-slate-900 dark:text-white font-medium">Sennova (SENA)</span>, hasta soluciones de comercio electrónico de alto rendimiento y herramientas experimentales que ejecutan <span class="text-slate-900 dark:text-white font-medium">modelos de inteligencia artificial directamente en el navegador del usuario</span>.
    </p>

    <p>
      Actualmente concentro parte de mi tiempo como desarrollador independiente en una plataforma web integral para consultorios médicos y profesionales de la salud en Colombia, automatizando la gestión de historias clínicas, agendamiento de citas, facturación electrónica y generación de archivos normativos <span class="font-mono-tech text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-sky-700 dark:text-sky-300 font-semibold">RIPS</span>.
    </p>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 border-l-2 border-sky-500/40 pl-4 py-1">
      Creo en el software predecible, bien documentado y con interfaces limpias que resuelven problemas concretos sin fricción innecesaria.
    </p>
  </div>

  <!-- Columna Visual y Reproductor de Audio Avanzado (5 cols) -->
  <div class="md:col-span-5 flex flex-col gap-4">
    <!-- Marco fotográfico editorial -->
    <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 shadow-sm">
      <img
        width="400"
        height="400"
        src={PERSONAL.images.photo}
        alt={`${PERSONAL.fullName} - Analista y diseñador de sistemas`}
        class="w-full aspect-square object-cover object-center"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
      <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs font-mono-tech text-white/90">
        <span>{PERSONAL.fullName}</span>
        <span class="text-sky-300">Cali, CO</span>
      </div>
    </div>

    <!-- Reproductor de Audio Profesional Studio Console -->
    <div
      role="region"
      aria-label="Reproductor de audio ensayo"
      class="audio-card rounded-2xl p-4 shadow-sm backdrop-blur-xs flex flex-col gap-3.5 transition-all"
    >
      <!-- Cabecera de Telemetría del Audio -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="relative flex size-2">
            <span id="audio-live-ping" class="absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-0 transition-opacity duration-300"></span>
            <span class="relative inline-flex rounded-full size-2 bg-sky-500"></span>
          </span>
          <span class="text-[11px] font-mono-tech uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold">
            Audio Ensayo
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-xs font-mono-tech text-slate-500 dark:text-slate-400 font-medium" id="audio-time">
            0:00 / 2:15
          </span>
        </div>
      </div>

      <!-- Título de la pista y Barra de Progreso -->
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-800 dark:text-slate-200 tracking-tight">
            La navaja suiza: análisis y desarrollo
          </span>
          <a
            href="/la-navaja-suiza-analisis.mp3"
            download="la-navaja-suiza-julian-llanten.mp3"
            class="text-[11px] font-mono-tech text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors flex items-center gap-1"
            title="Descargar archivo MP3"
            aria-label="Descargar archivo MP3"
          >
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            <span>MP3</span>
          </a>
        </div>

        <!-- Barra de progreso interactiva, accesible y con soporte scrubbing -->
        <div
          id="audio-progress-container"
          role="slider"
          aria-label="Progreso del audio"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          tabindex="0"
          class="group/track relative w-full h-2 bg-slate-200/80 dark:bg-slate-800/80 rounded-full cursor-pointer overflow-hidden transition-all hover:h-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 touch-none"
        >
          <div
            id="audio-progress-bar"
            class="h-full bg-gradient-to-r from-sky-600 to-sky-400 dark:from-sky-500 dark:to-cyan-400 rounded-full w-0 transition-all duration-75 relative"
          ></div>
        </div>
      </div>

      <!-- Controles Principales de Reproducción -->
      <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-slate-800/60">
        <!-- Grupo de Transporte: -10s, Play/Pause, +10s con Touch Targets amplios -->
        <div class="flex items-center gap-1.5 sm:gap-2">
          <!-- Retroceder 10 segundos -->
          <button
            type="button"
            id="rewind-btn"
            aria-label="Retroceder 10 segundos"
            title="Retroceder 10 segundos"
            class="audio-sub-button size-9 sm:size-8 rounded-lg flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 17l-5-5 5-5M18 17l-5-5 5-5" />
            </svg>
          </button>

          <!-- Play / Pause Principal -->
          <button
            type="button"
            id="custom-audio-play-btn"
            aria-label="Reproducir audio"
            class="audio-play-button size-10 rounded-full flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 transition-all active:scale-95 shadow-sm"
          >
            <svg id="play-icon" class="size-4 ml-0.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
            <svg id="pause-icon" class="size-4 hidden" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
            </svg>
          </button>

          <!-- Adelantar 10 segundos -->
          <button
            type="button"
            id="forward-btn"
            aria-label="Adelantar 10 segundos"
            title="Adelantar 10 segundos"
            class="audio-sub-button size-9 sm:size-8 rounded-lg flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 17l5-5-5-5M6 17l5-5-5-5" />
            </svg>
          </button>
        </div>

        <!-- Grupo Secundario: Selector de Velocidad y Control de Volumen -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Selector de Velocidad (1x, 1.25x, 1.5x, 2x) -->
          <button
            type="button"
            id="speed-btn"
            aria-label="Cambiar velocidad de reproducción. Actual: 1x"
            title="Cambiar velocidad de reproducción"
            class="h-8 px-2 py-1 rounded-md text-xs font-mono-tech font-bold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
          >
            <span id="speed-text">1.0x</span>
          </button>

          <!-- Control de Volumen con Mute y Slider adaptativo (oculto en móvil) -->
          <div class="flex items-center gap-1.5 group/volume relative">
            <button
              type="button"
              id="mute-btn"
              aria-label="Silenciar o activar sonido"
              title="Silenciar sonido"
              class="audio-sub-button size-9 sm:size-8 rounded-lg flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors"
            >
              <!-- Icono volumen alto -->
              <svg id="volume-high-icon" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07" />
              </svg>
              <!-- Icono volumen silenciado -->
              <svg id="volume-muted-icon" class="size-4 hidden text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                <line x1="23" y1="9" x2="17" y2="15" />
                <line x1="17" y1="9" x2="23" y2="15" />
              </svg>
            </button>

            <!-- Slider de Volumen fluido (visible en tablet/desktop, oculto en mobile) -->
            <input
              type="range"
              id="volume-slider"
              min="0"
              max="1"
              step="0.05"
              value="1"
              aria-label="Nivel de volumen"
              class="hidden sm:block w-14 sm:w-16 h-1.5 bg-slate-200 dark:bg-slate-800 rounded-lg appearance-none cursor-pointer accent-sky-600 dark:accent-sky-400"
            />
          </div>
        </div>
      </div>

      <!-- Elemento de audio nativo -->
      <audio id="personal-audio" preload="metadata" src="/la-navaja-suiza-analisis.mp3"></audio>
    </div>
  </div>
</article>

<style>
  .audio-card {
    background-color: color-mix(in oklch, var(--color-surface) 90%, transparent);
    border: 1px solid var(--color-border-subtle);
  }

  .audio-play-button {
    background-color: var(--color-text-main);
    color: var(--color-canvas);

    &:hover {
      background-color: var(--color-accent);
      color: oklch(100% 0 0);
    }
  }

  .audio-sub-button {
    &:hover {
      background-color: color-mix(in oklch, var(--color-text-muted) 15%, transparent);
    }
  }

  /* Personalización del slider de volumen */
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: currentColor;
    cursor: pointer;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const audio = document.getElementById('personal-audio') as HTMLAudioElement | null
    const playBtn = document.getElementById('custom-audio-play-btn')
    const playIcon = document.getElementById('play-icon')
    const pauseIcon = document.getElementById('pause-icon')
    const timeDisplay = document.getElementById('audio-time')
    const progressBar = document.getElementById('audio-progress-bar')
    const progressContainer = document.getElementById('audio-progress-container')
    const livePing = document.getElementById('audio-live-ping')

    const rewindBtn = document.getElementById('rewind-btn')
    const forwardBtn = document.getElementById('forward-btn')
    const speedBtn = document.getElementById('speed-btn')
    const speedText = document.getElementById('speed-text')
    const muteBtn = document.getElementById('mute-btn')
    const volumeHighIcon = document.getElementById('volume-high-icon')
    const volumeMutedIcon = document.getElementById('volume-muted-icon')
    const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement | null

    if (!audio || !playBtn || !playIcon || !pauseIcon || !timeDisplay || !progressBar || !progressContainer) return

    let previousVolume = 1
    const speeds = [1.0, 1.25, 1.5, 2.0]
    let currentSpeedIndex = 0
    let isDragging = false

    const formatTime = (seconds: number) => {
      if (isNaN(seconds) || seconds <= 0) return '0:00'
      const m = Math.floor(seconds / 60)
      const s = Math.floor(seconds % 60)
      return `${m}:${s < 10 ? '0' : ''}${s}`
    }

    const setPlayingState = (isPlaying: boolean) => {
      if (isPlaying) {
        playIcon.classList.add('hidden')
        pauseIcon.classList.remove('hidden')
        livePing?.classList.remove('opacity-0')
        livePing?.classList.add('animate-ping', 'opacity-75')
      } else {
        playIcon.classList.remove('hidden')
        pauseIcon.classList.add('hidden')
        livePing?.classList.remove('animate-ping', 'opacity-75')
        livePing?.classList.add('opacity-0')
      }
    }

    const togglePlay = () => {
      if (audio.paused) {
        audio.play().then(() => setPlayingState(true)).catch(() => {})
      } else {
        audio.pause()
        setPlayingState(false)
      }
    }

    playBtn.addEventListener('click', togglePlay)

    // Actualización de progreso
    audio.addEventListener('timeupdate', () => {
      if (isDragging) return
      const current = audio.currentTime
      const duration = audio.duration || 135
      const percent = duration > 0 ? (current / duration) * 100 : 0
      progressBar.style.width = `${percent}%`
      progressContainer.setAttribute('aria-valuenow', Math.round(percent).toString())
      timeDisplay.textContent = `${formatTime(current)} / ${formatTime(duration)}`
    })

    audio.addEventListener('loadedmetadata', () => {
      timeDisplay.textContent = `0:00 / ${formatTime(audio.duration)}`
    })

    audio.addEventListener('ended', () => {
      setPlayingState(false)
      progressBar.style.width = '0%'
      audio.currentTime = 0
    })

    // Scrubbing interactivo continuo con eventos Pointer
    const seekWithPointer = (e: PointerEvent) => {
      const rect = progressContainer.getBoundingClientRect()
      const clickX = Math.max(0, Math.min(e.clientX - rect.left, rect.width))
      const percent = clickX / rect.width
      const duration = audio.duration || 135
      audio.currentTime = percent * duration
      progressBar.style.width = `${percent * 100}%`
      progressContainer.setAttribute('aria-valuenow', Math.round(percent * 100).toString())
      timeDisplay.textContent = `${formatTime(audio.currentTime)} / ${formatTime(duration)}`
    }

    progressContainer.addEventListener('pointerdown', (e) => {
      isDragging = true
      seekWithPointer(e)
      progressContainer.setPointerCapture(e.pointerId)
    })

    progressContainer.addEventListener('pointermove', (e) => {
      if (isDragging) {
        seekWithPointer(e)
      }
    })

    const stopDragging = (e: PointerEvent) => {
      if (isDragging) {
        isDragging = false
        try { progressContainer.releasePointerCapture(e.pointerId) } catch (_) {}
      }
    }

    progressContainer.addEventListener('pointerup', stopDragging)
    progressContainer.addEventListener('pointercancel', stopDragging)

    // Retroceder y adelantar 10 segundos
    rewindBtn?.addEventListener('click', () => {
      audio.currentTime = Math.max(0, audio.currentTime - 10)
    })

    forwardBtn?.addEventListener('click', () => {
      const duration = audio.duration || 135
      audio.currentTime = Math.min(duration, audio.currentTime + 10)
    })

    // Ciclo de velocidad (1.0x -> 1.25x -> 1.5x -> 2.0x)
    speedBtn?.addEventListener('click', () => {
      currentSpeedIndex = (currentSpeedIndex + 1) % speeds.length
      const newSpeed = speeds[currentSpeedIndex]
      audio.playbackRate = newSpeed
      if (speedText) speedText.textContent = `${newSpeed.toFixed(1)}x`
      speedBtn.setAttribute('aria-label', `Velocidad actual ${newSpeed}x. Clic para cambiar.`)
    })

    // Control de volumen y mute
    const updateVolumeUI = (vol: number) => {
      if (vol === 0) {
        volumeHighIcon?.classList.add('hidden')
        volumeMutedIcon?.classList.remove('hidden')
      } else {
        volumeHighIcon?.classList.remove('hidden')
        volumeMutedIcon?.classList.add('hidden')
      }
      if (volumeSlider) volumeSlider.value = vol.toString()
    }

    muteBtn?.addEventListener('click', () => {
      if (audio.muted || audio.volume === 0) {
        audio.muted = false
        audio.volume = previousVolume > 0 ? previousVolume : 0.8
        updateVolumeUI(audio.volume)
      } else {
        previousVolume = audio.volume
        audio.volume = 0
        audio.muted = true
        updateVolumeUI(0)
      }
    })

    volumeSlider?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement
      const val = parseFloat(target.value)
      audio.volume = val
      audio.muted = val === 0
      previousVolume = val > 0 ? val : previousVolume
      updateVolumeUI(val)
    })

    // Accesibilidad por teclado en el contenedor de progreso
    progressContainer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        audio.currentTime = Math.max(0, audio.currentTime - 5)
      } else if (e.key === 'ArrowRight') {
        const duration = audio.duration || 135
        audio.currentTime = Math.min(duration, audio.currentTime + 5)
      } else if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault()
        togglePlay()
      }
    })
  })
</script>