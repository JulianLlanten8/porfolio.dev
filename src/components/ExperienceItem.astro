---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
}

const { title, company, description, link, date } = Astro.props
---

<div class="relative grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 first:pt-0 last:pb-0 border-b border-slate-200/80 dark:border-slate-800/80 last:border-b-0">
  <!-- Período y Entidad (4 cols) -->
  <div class="md:col-span-4 flex flex-col gap-1">
    <span class="font-mono-tech text-xs font-semibold text-sky-600 dark:text-sky-400 tracking-wider uppercase">
      {date}
    </span>
    <h4 class="text-base font-bold text-slate-900 dark:text-white">
      {company}
    </h4>
    {
      link && (
        <div class="pt-1">
          <LinkInline href={link} class="text-xs">
            Visitar sitio
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-3.5 inline"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
              <path d="M11 13l9 -9" />
              <path d="M15 4h5v5" />
            </svg>
          </LinkInline>
        </div>
      )
    }
  </div>

  <!-- Rol y Logros (8 cols) -->
  <div class="md:col-span-8 flex flex-col gap-2">
    <h3 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">
      {title}
    </h3>
    <p class="text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300 text-pretty">
      {description}
    </p>
  </div>
</div>