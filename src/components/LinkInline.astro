---
interface Props {
  href: string
  class?: string
}

const { href, class: className = '' } = Astro.props;
---

<a
  href={href}
  role="link"
  class={`inline-flex items-center gap-1 font-medium text-sky-700 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 hover:underline transition-colors ${className}`}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>