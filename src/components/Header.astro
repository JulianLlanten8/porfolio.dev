---
import { PERSONAL } from '@/config/personal'
import ThemeToggle from './ThemeToggle.astro'

const navItems = [
  { title: 'Proyectos',   label: 'proyectos',   url: '/#proyectos'   },
  { title: 'Experiencia', label: 'experiencia', url: '/#experiencia' },
  { title: 'Sobre mí',   label: 'sobre-mi',    url: '/#sobre-mi'    },
  { title: 'Contacto',   label: 'contacto',    url: `mailto:${PERSONAL.email}` },
]
---

<header class="fixed top-0 inset-x-0 z-50 flex items-center justify-center px-2 sm:px-4 py-2 sm:py-3 pointer-events-none">
  <div class="pointer-events-auto flex items-center gap-1 sm:gap-2 px-2 sm:px-3 py-1 sm:py-1.5 rounded-full border border-slate-200/80 dark:border-slate-800/80 bg-white/85 dark:bg-[#0c1220]/85 shadow-sm shadow-slate-950/5 dark:shadow-black/20 backdrop-blur-md transition-all duration-300 max-w-[calc(100vw-1rem)]">
    <a
      href="/"
      class="flex items-center gap-1.5 pl-1 pr-1.5 py-0.5 text-xs sm:text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100 hover:text-sky-600 dark:hover:text-sky-400 transition-colors"
      aria-label="Ir al inicio"
    >
      <span class="inline-flex items-center justify-center size-5 sm:size-6 rounded-full bg-slate-900 dark:bg-slate-100 text-[#f8fafc] dark:text-[#090d16] font-mono-tech text-[10px] sm:text-xs font-bold">
        JL
      </span>
      <span class="hidden md:inline font-mono-tech text-xs text-slate-500 dark:text-slate-400 font-normal">/ systems</span>
    </a>

    <span class="w-px h-3.5 sm:h-4 bg-slate-200 dark:bg-slate-800" aria-hidden="true"></span>

    <nav class="flex items-center gap-0.5 sm:gap-1">
      {
        navItems.map((link) => (
          <a
            class="nav-link px-1.5 sm:px-2.5 py-0.5 sm:py-1 text-[11px] sm:text-xs md:text-sm font-medium text-slate-600 dark:text-slate-300 rounded-full hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors whitespace-nowrap"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <span class="w-px h-3.5 sm:h-4 bg-slate-200 dark:bg-slate-800" aria-hidden="true"></span>

    <div class="flex items-center pl-0.5 sm:pl-1">
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('section[id]')
    const navItems = document.querySelectorAll('header nav a.nav-link')

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const currentId = entry.target.id
          navItems.forEach((item) => {
            if (item.getAttribute('aria-label') === currentId) {
              item.classList.add('text-sky-600', 'dark:text-sky-400', 'bg-sky-50', 'dark:bg-sky-950/40')
              item.classList.remove('text-slate-600', 'dark:text-slate-300')
            } else {
              item.classList.remove('text-sky-600', 'dark:text-sky-400', 'bg-sky-50', 'dark:bg-sky-950/40')
              item.classList.add('text-slate-600', 'dark:text-slate-300')
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: '-20% 0px -70% 0px',
      threshold: 0,
    })

    sections.forEach((section) => observer.observe(section))

    document.onvisibilitychange = () => {
      if (document.visibilityState === 'hidden') {
        observer.disconnect()
      } else {
        sections.forEach((section) => observer.observe(section))
      }
    }
  })
</script>