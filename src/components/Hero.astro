---
import { PERSONAL } from '@/config/personal'
import Badge from '@/components/Badge.astro'
import LinkedInIcon from '@/components/icons/LinkedIn.astro'
import GitHubIcon from '@/components/icons/GitHub.astro'
import MailIcon from '@/components/icons/Mail.astro'
import Download from '@/components/icons/Download.astro'
import SocialPill from '@/components/SocialPill.astro'
import DownloadPill from '@/components/DownloadPill.astro'
---

<div class="flex flex-col gap-8">
  <!-- Cabecera de estado y localización -->
  <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
    <a
      href={PERSONAL.social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="transition hover:opacity-85 focus:outline-none"
      aria-label="Ver perfil de LinkedIn"
    >
      <Badge>Disponible para proyectos y consultoría</Badge>
    </a>
    <span class="font-mono-tech text-slate-500 dark:text-slate-400">
      {PERSONAL.location} · UTC-5
    </span>
  </div>

  <!-- Identidad y titular -->
  <div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-6">
    <div class="flex-1">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-[1.12]">
        {PERSONAL.name}
      </h1>
      <p class="mt-2 text-lg sm:text-xl font-medium text-sky-700 dark:text-sky-400 tracking-tight">
        {PERSONAL.role}
      </p>

      <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl text-pretty">
        Diseño arquitecturas de software robustas y desarrollo aplicaciones web con enfoque en rendimiento, modelado de datos e inteligencia artificial nativa. Convierto problemas complejos de negocio en herramientas digitales precisas y escalables.
      </p>
    </div>

    <!-- Fotografía / Avatar con encuadre técnico -->
    <div class="relative shrink-0">
      <div class="relative size-24 sm:size-28 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 shadow-md">
        <img
          class="w-full h-full object-cover"
          src={PERSONAL.images.avatar}
          alt={`${PERSONAL.name} — ${PERSONAL.role}`}
          width="112"
          height="112"
          loading="eager"
        />
      </div>
      <div class="absolute -bottom-1 -right-1 size-5 rounded-md bg-white dark:bg-[#090d16] border border-slate-200 dark:border-slate-800 flex items-center justify-center">
        <span class="size-2 rounded-full bg-emerald-500"></span>
      </div>
    </div>
  </div>

  <!-- Métricas de ingeniería / Señales técnicas -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 py-4 border-y border-slate-200/80 dark:border-slate-800/80">
    <div class="flex flex-col gap-0.5">
      <span class="font-mono-tech text-xs text-slate-500 dark:text-slate-400">TRAYECTORIA</span>
      <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">+4 años en producción</span>
    </div>
    <div class="flex flex-col gap-0.5">
      <span class="font-mono-tech text-xs text-slate-500 dark:text-slate-400">ESPECIALIDAD</span>
      <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Arquitectura Full Stack & IA</span>
    </div>
    <div class="flex flex-col gap-0.5">
      <span class="font-mono-tech text-xs text-slate-500 dark:text-slate-400">SECTORES CLAVE</span>
      <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Salud, E-commerce & Backoffice</span>
    </div>
  </div>

  <!-- Acciones y enlaces -->
  <nav class="flex flex-wrap items-center gap-2.5 pt-1">
    <DownloadPill href={PERSONAL.cv} download>
      <Download class="size-4" />
      Descargar CV (PDF)
    </DownloadPill>

    <SocialPill href={`mailto:${PERSONAL.email}`} aria-label="Enviar correo electrónico a Julián">
      <MailIcon class="size-4" />
      Contacto
    </SocialPill>

    <SocialPill href={PERSONAL.social.github} aria-label="Visitar el perfil de GitHub de Julián">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>

    <SocialPill href={PERSONAL.social.linkedin} aria-label="Visitar el perfil de LinkedIn de Julián">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>