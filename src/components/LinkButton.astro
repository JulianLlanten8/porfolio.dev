---
interface Props {
  href: string
  variant?: 'primary' | 'secondary'
}

const { href, variant = 'secondary' } = Astro.props

const baseClasses = "inline-flex items-center justify-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 active:scale-[0.98]"

const variantClasses = variant === 'primary'
  ? "text-white bg-slate-900 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-white shadow-sm"
  : "text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 hover:text-slate-950 dark:hover:text-white"
---

<a
  href={href}
  role="link"
  target="_blank"
  rel="noopener noreferrer"
  class={`${baseClasses} ${variantClasses}`}
>
  <slot />
</a>