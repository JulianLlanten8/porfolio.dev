---
import '@fontsource-variable/onest'
import { ClientRouter } from 'astro:transitions'
import { PERSONAL } from '@/config/personal'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import '@/styles/global.css'

interface Props {
  title: string
  description: string
  keywords: string
}

const { description, title, keywords } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={PERSONAL.fullName} />
    <meta name="theme-color" content="#090d16" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href={PERSONAL.images.avatar} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={PERSONAL.site} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={`${Astro.url.origin}${PERSONAL.images.avatar}`} />
    <meta property="og:site_name" content={PERSONAL.fullName} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.url.origin}${PERSONAL.images.avatar}`} />
    <meta name="twitter:site" content={PERSONAL.twitter} />
    <meta name="twitter:creator" content={PERSONAL.twitter} />

    <!-- Datos Estructurados JSON-LD (SEO) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": PERSONAL.fullName,
      "jobTitle": PERSONAL.role,
      "url": PERSONAL.site,
      "image": `${Astro.url.origin}${PERSONAL.images.avatar}`,
      "sameAs": Object.values(PERSONAL.social),
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cali",
        "addressCountry": "CO"
      }
    })} />

    <title>{title}</title>
    <ClientRouter />
  </head>

  <body class="relative min-h-screen text-[var(--color-text-main)] bg-[var(--color-canvas)] selection:bg-sky-500/20 selection:text-sky-900 dark:selection:text-sky-100">
    <!-- Fondo estructural sutil de ingeniería -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-[-1] overflow-hidden"
    >
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(56,189,248,0.08),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(14,165,233,0.12),rgba(9,13,22,0))]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#e2e8f015_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f015_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#1e293b20_1px,transparent_1px),linear-gradient(to_bottom,#1e293b20_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <Header />
    <slot />
    <Footer />
  </body>
</html>